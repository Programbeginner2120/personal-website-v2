---
import { Font } from 'astro:assets';
import '@/styles/global.css';
import { site } from '@/data/site';
import type { Theme } from '@/types/site';

interface Props {
  title?: string;
  description?: string;
  theme?: Theme;
  /** Hide from search engines (e.g. the style guide). */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  theme = site.theme,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.name;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Colours the mobile browser UI (address bar) to match the page background.
const themeColor: Record<Theme, string> = { green: '#070A08', blue: '#0A1C42' };
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content={themeColor[theme]} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <!-- Generated from src/assets/Portrait.jpg by src/pages/favicon.png.ts and apple-touch-icon.png.ts -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />

    <!--
      Runs before first paint (is:inline = not bundled). Marks the page as
      "about to animate" so the hero starts hidden instead of flashing.
      The timeout is a safety net: if the animation script never runs,
      the content is revealed anyway.
    -->
    <script is:inline>
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const root = document.documentElement;
        root.classList.add('js-reveal');
        setTimeout(() => root.classList.remove('js-reveal'), 3000);
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
