---
import type { NavLink } from '@/types/site';

interface Props {
  domain: string;
  nav: NavLink[];
}

const { domain, nav } = Astro.props;
---
<header class="wrap header label">
  <a class="header__brand" href="/">
    <span class="header__dot" aria-hidden="true"></span>{domain}
  </a>
  <nav aria-label="Primary">
    {nav.map(({ label, href, cta }) => (
      <a href={href} class:list={{ cta }}>{label}</a>
    ))}
  </nav>
</header>

<style>
  .header {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center;
    gap: 4px 24px; padding-block: 22px;
  }
  .header__brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .header__dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--accent);
    animation: blink 1.1s step-end infinite;
  }
  nav { display: flex; flex-wrap: wrap; gap: 0 28px; }
  /* Tall padding = comfortable touch targets without changing the look */
  nav a { text-decoration: none; padding: 12px 0; }
  nav a.cta { color: var(--accent); }
  @keyframes blink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: .25; } }

  /* Phones: brand on its own line, nav spread edge to edge underneath */
  @media (max-width: 600px) {
    .header { padding-block: 16px 4px; }
    nav { width: 100%; justify-content: space-between; gap: 0 12px; font-size: 13px; }
  }
</style>
